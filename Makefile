# Developer tasks. To upscale, use the arc-upscale command (see README.md).

ROOT := $(patsubst %/,%,$(dir $(abspath $(lastword $(MAKEFILE_LIST)))))
UV_RUN := uv run --project "$(ROOT)"

# Where `make install` links the command.
BINDIR ?= $(HOME)/.local/bin
# GPU index for `make test`, as listed by `arc-upscale gpus`.
GPU ?= 0

.DEFAULT_GOAL := help

.PHONY: install uninstall test lint clean

install: install-deps ## Install the environment and link arc-upscale into BINDIR (default ~/.local/bin)
	mkdir -p "$(BINDIR)"
	ln -sfn "$(ROOT)/arc-upscale" "$(BINDIR)/arc-upscale"

uninstall: ## Remove the arc-upscale link from BINDIR
	rm -f "$(BINDIR)/arc-upscale"

test: ## Run pytest; GPU tests run on GPU=<index>
	ARC_UPSCALE_ROOT="$(ROOT)" $(UV_RUN) pytest "$(ROOT)/tests" --gpu $(GPU)

# --only-dev: linting needs the linters, not the 7 GB PyTorch environment.
lint: ## shellcheck and ruff
	$(UV_RUN) --only-dev shellcheck "$(ROOT)/arc-upscale"
	$(UV_RUN) --only-dev ruff check "$(ROOT)"
	$(UV_RUN) --only-dev ruff format --check "$(ROOT)"

clean: ## Remove ./out in the project
	rm -rf "$(ROOT)/out"

